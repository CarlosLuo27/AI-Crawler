# Copy this file to .env and fill in your API credentials.
OPENAI_API_KEY=sk-...
# Optionally override the default model (defaults to gpt-3.1-mini)
# OPENAI_MODEL=gpt-3.1-mini

# Required for fetching news articles from https://newsapi.org
NEWS_API_KEY=your-newsapi-key
# Optional overrides
# NEWS_LANGUAGE=en
# MAX_ARTICLES_PER_KEYWORD=15
# REQUEST_TIMEOUT=30
